#!/bin/sh
set -eu
# Include both pure-Perl and architecture-specific modules from the staged Perl.
PERL5LIB="$SNAP/usr/share/perl5"
for directory in "$SNAP"/usr/share/perl/[0-9]* "$SNAP"/usr/lib/*/perl/[0-9]*; do
    if [ -d "$directory" ]; then
        PERL5LIB="$PERL5LIB:$directory"
    fi
done
export PERL5LIB
exec "$SNAP/usr/bin/perl" "$SNAP/usr/bin/exiftool" "$@"
